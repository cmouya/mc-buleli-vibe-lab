{
  "name": "learnova",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:api": "vitest run --config vitest.api.config.js",
    "test:db": "vitest run --config vitest.db.config.js",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.20.2",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.3",
    "vite": "^7.1.3",
    "vitest": "^3.0.9"
  },
  "dependencies": {
    "@fastify/swagger": "^9.8.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.3",
    "postgres": "^3.4.9"
  }
}
